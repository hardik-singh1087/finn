# FINN — environment variables. Copy to `.env.local` (Next.js) and `.env` is read by the
# Python pipeline too. NEVER commit the filled-in versions; only this .example is tracked.

# --- Model provider (only needed when generating feed summaries + research) ---
# Default routing uses Claude models (see config/finn.config.json "models").
ANTHROPIC_API_KEY=

# Optional: if you swap any step to another provider, add its key here.
# OPENAI_API_KEY=

# --- App ---
# Base URL of the deployed app (used for absolute links in share/push previews).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Data pipeline (optional overrides) ---
# Where screener.in / exchange fetches cache raw downloads before parsing.
# PIPELINE_CACHE_DIR=data/.cache
