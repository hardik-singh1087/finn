# FINN — environment variables. Copy to `.env.local` (Next.js) and `.env` is read by the
# Python pipeline too. NEVER commit the filled-in versions; only this .example is tracked.

# --- Bulk/cheap jobs: Gemini FREE tier (default) ---
# Used for announcement classification + short "why it matters" summaries.
# gemini-2.0-flash is free-tier eligible. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional paid alternative for the same bulk jobs (engine=anthropic) ---
# Only needed if you deliberately switch off Gemini. See config/finn.config.json "models".
ANTHROPIC_API_KEY=

# --- App ---
# Base URL of the deployed app (used for absolute links in share/push previews).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Data pipeline (optional overrides) ---
# Where screener.in / exchange fetches cache raw downloads before parsing.
# PIPELINE_CACHE_DIR=data/.cache
